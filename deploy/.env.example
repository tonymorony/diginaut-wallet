# Copy to .env next to docker-compose.yml and fill in. Only the wallet's HTTP
# port is published; indexer/faucet/electrumx stay on the compose-internal
# network and are reached through the wallet's same-origin proxies.

# --- Your DigiByte Core node (v9.26+, digibyte.conf: server=1, txindex=1) ---
# From inside containers "host.docker.internal" = the docker host machine.
DGB_RPC_URL=http://host.docker.internal:18500
DGB_RPC_USER=
DGB_RPC_PASS=
# ElectrumX wants the same node with credentials inline:
DAEMON_URL=http://user:pass@host.docker.internal:18500

# --- Which chain the node runs (must all agree) ---
# regtest: DGB_NET=regtest, DGB_HRP=dgbrt · testnet: DGB_NET=testnet, DGB_HRP=dgbt
DGB_NET=regtest
DGB_HRP=dgbrt

# --- Faucet ---
# Name of the node wallet holding faucet funds (created with `createwallet`,
# funded by the operator — docs/SELF-HOSTING.md describes the top-up procedure).
FAUCET_WALLET=faucet
FAUCET_TARGET_DD_CENTS=5000
FAUCET_COOLDOWN_HOURS=24

# --- Wallet ---
WALLET_PORT=8791
# Stablecoin flows (mint/transfer/redeem) are always on, TOGETHER (ADR-0002);
# the release gate (#17) removed the FEATURE_MINT flag.

# Trust X-Forwarded-For for per-IP rate limiting and for the address the Faucet
# sees. Set to 1 ONLY when a reverse proxy you control is in front (the TLS and
# dual overlays set it for you). MUST stay 0 when the wallet port is published
# directly — docker-compose.yml does publish 8791 — because a trusted header a
# client can write is a free rate-limit bypass.
#TRUST_PROXY=0
# Fixed-window per-IP budgets (per RATE_LIMIT_WINDOW_MS). 0 = unlimited.
# The indexer budget must stay in the thousands: a restored wallet's money poll
# alone is (address index + 3) x 6 reads every 8 s, plus history enrichment.
#RATE_LIMIT_WINDOW_MS=60000
#RATE_LIMIT_RPC_PER_MIN=120
#RATE_LIMIT_INDEXER_PER_MIN=6000
#RATE_LIMIT_FAUCET_PER_MIN=20
# Request body caps, bytes. The RPC default admits any transaction the node
# would relay (~800 KB of hex for a max-standard tx) and nothing larger.
#MAX_RPC_BODY_BYTES=1048576
#MAX_FAUCET_BODY_BYTES=16384

# --- Public TLS (docker-compose.tls.yml overlay) ---
# Public hostname(s) for the wallet, comma-separated; Caddy fetches the
# certificates automatically. (DOMAIN= is the legacy single-name spelling.)
DOMAINS=
DOMAIN=
# The TLS and dual overlays set HSTS=1 and TRUST_PROXY=1 on the wallet for you.
# Leave HSTS off for plain-http or localhost hosting: it pins the whole origin
# (and, with includeSubDomains, every name under it) to https in the browser
# for 180 days, with no easy undo.
#HSTS=0

# --- Dual-network deployment (docker-compose.dual.yml overlay, #64) ---
# The base stack above becomes the TESTNET side; these add the MAINNET side.
# Every mainnet value is MAINNET_*-prefixed on purpose: nothing here falls
# back to a testnet setting, so the two networks cannot cross-wire. Both
# wallets also verify the chain their node reports (EXPECTED_CHAIN guard)
# and refuse to serve on a mismatch.
#TESTNET_DOMAINS=dgb.example.com
#MAINNET_DOMAINS=diginaut.example.com
#MAINNET_RPC_URL=http://host.docker.internal:14022
#MAINNET_RPC_USER=
#MAINNET_RPC_PASS=
#MAINNET_DAEMON_URL=http://user:pass@host.docker.internal:14022
#MAINNET_EXPLORER_TX_URL=https://digiexplorer.info/tx/
