{
  "name": "digidollar-wallet-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "digidollar-wallet-monorepo",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/wallet": {
      "name": "@digidollar/wallet",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "digidollar-js": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@digidollar/wallet": {
      "resolved": "apps/wallet",
      "link": true
    },
    "node_modules/digidollar-js": {
      "resolved": "packages/digidollar-js",
      "link": true
    },
    "packages/digidollar-js": {
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
