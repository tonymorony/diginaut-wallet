# Copy to .env and fill in to talk to a real DigiByte Core testnet node.
# Without these, the UI runs in MOCK mode (realistic fake data, no node needed).

PORT=8787

# Which interface to listen on. Default 127.0.0.1 — reachable from this machine
# only, which is what you want when you run `node server.js` directly. Set
# 0.0.0.0 to accept traffic from elsewhere (deploy/*.yml does this for the
# container, with Caddy in front); do that only behind something you trust.
BIND_HOST=127.0.0.1

# DigiByte Core RPC endpoint. Use the rpcport from your digibyte.conf
# (check `rpcport=` in the [test] section for testnet — it differs from mainnet).
# Also set: server=1, rpcuser=..., rpcpassword=..., and run the node with -testnet.
DGB_RPC_URL=http://127.0.0.1:14022
DGB_RPC_USER=
DGB_RPC_PASS=

# Faucet service base URL (apps/faucet). Unset = no "Get testnet DGB" button.
FAUCET_URL=

# Indexer facade base URL (apps/indexer). Unset = no balance/history in the UI.
INDEXER_URL=
