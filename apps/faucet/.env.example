# Copy to .env and fill in. The Faucet has NO mock mode — it needs a node
# with a funded hot wallet (a project-operated wallet, never a user Wallet).

PORT=8788

# Which interface to listen on. Default 127.0.0.1. This is the one service that
# can spend (the hot wallet), so leave it on loopback unless something you
# control is in front; deploy/*.yml sets 0.0.0.0 for the compose network only.
BIND_HOST=127.0.0.1

# DigiByte Core RPC endpoint + the hot wallet holding faucet funds.
DGB_RPC_URL=http://127.0.0.1:14022
DGB_RPC_USER=
DGB_RPC_PASS=
DGB_RPC_WALLET=faucet

# Claim ledger file (per-address + per-IP cooldowns survive restarts).
FAUCET_DATA_FILE=./faucet-claims.json

# Sizing target: dispense enough to Mint this many DigiDollar cents on the
# six-month tier at the live Oracle price (5000 = $50), +10%, whole DGB.
FAUCET_TARGET_DD_CENTS=5000
FAUCET_COOLDOWN_HOURS=24
