# Copy to .env. The facade answers address-level DGB queries for the wallet;
# it needs a running ElectrumX (see scripts/electrumx-regtest/ for regtest).

PORT=8789

# Which interface to listen on. Default 127.0.0.1. This facade has no auth of
# its own and proxies ElectrumX unthrottled, so it should never face a network
# directly: 0.0.0.0 belongs to the container (deploy/*.yml), where it means the
# compose network and no port is published.
BIND_HOST=127.0.0.1

# Which network's addresses to accept: dgb (mainnet) | dgbt (testnet) | dgbrt (regtest)
DGB_HRP=dgbt

ELECTRUM_HOST=127.0.0.1
ELECTRUM_PORT=50001
